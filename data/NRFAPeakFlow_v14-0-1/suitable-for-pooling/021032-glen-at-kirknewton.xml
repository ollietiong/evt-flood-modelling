            <Usage notes="Gauged beyond AMAX3. Known to bypass in large floods and peak hydrograph shape is sometimes questionable, but magnitude of gauged peaks warrants inclusion." suitable="Yes" type="Pooling"/>
        </Usages>
    </GaugingStation>
