            <Usage notes="Flow estimates reasonable." suitable="Yes" type="QMED"/>
            <Usage notes="No high flow gaugings on either structure exist and both exhibit bypassing." suitable="No" type="Pooling"/>
        </Usages>
    </GaugingStation>
