            <Usage notes="No comment." suitable="Yes" type="QMED"/>
            <Usage notes="Uncertainty as to quality at higher flows due to bypassing,. Needs a re-assessment by SEPA to clarify worth." suitable="No" type="Pooling"/>
        </Usages>
    </GaugingStation>
